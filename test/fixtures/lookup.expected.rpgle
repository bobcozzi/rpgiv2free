                     ctl-opt dftactgrp(*NO) ACTGRP(*NEW);
                          arr char(10) DIM(20) ASCEND;
                          dumbReq char(10) inz('HONEY');
                          x int(10);
                          Arr = %LIST('SUGAR':'HONEY':'SYRUP':'CRAP');
                          SORTA arr;
                          X = 1;
                          x = %LOOKUPGT(dumbReq : arr :x);
                          *IN71 = %FOUND();
                          *IN72 = (%LOOKUPLT(dumbReq : arr ) > 0);
                          *IN72 = %FOUND();
                          *in73 = (%LOOKUP(dumbReq : arr) > 0);
                          *IN75 = (%LOOKUPGE(dumbReq : arr ) > 0);
                          *IN75 = %EQUAL();
                          *IN74 = %FOUND() and NOT %EQUAL();
                          *IN77 = (%LOOKUPLT(dumbReq : arr ) > 0);
                          *IN77 = %FOUND() and NOT %EQUAL();
                          *IN76 = %FOUND() and NOT %EQUAL();
                          *IN79 = (%LOOKUPLE(dumbReq : arr ) > 0);
                          *IN79 = %EQUAL();
                          *IN77 = %FOUND() and NOT %EQUAL();
